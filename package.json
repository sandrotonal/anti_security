{
  "name": "securify-cli",
  "version": "1.0.1",
  "description": "Securify - Enterprise Hardcoded Secrets, Leaks & CVE Dependency Security Scanner",
  "type": "module",
  "main": "./bin/securify.mjs",
  "bin": {
    "securify": "./bin/securify.mjs",
    "securify-cli": "./bin/securify.mjs"
  },
  "files": [
    "bin/securify.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "security",
    "secret-scanner",
    "cve",
    "osv",
    "sarif",
    "credentials",
    "audit",
    "devsecops"
  ],
  "scripts": {
    "dev": "vite",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=bin/securify.mjs",
    "build": "tsc -b && vite build && npm run build:cli",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src api",
    "test": "node --experimental-strip-types tests/security.test.mjs",
    "scan": "node bin/securify.mjs scan .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.14"
  }
}
